<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:semi="https://irihi.tech/semi"
             x:Class="Final.CPU8086.App"
             RequestedThemeVariant="Light">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Semi icon geometries (SemiIcon*) are not merged by SemiTheme; include them so
                     PathIcon Data="{StaticResource SemiIcon...}" resolves. -->
                <ResourceInclude Source="avares://Semi.Avalonia/Icons/FillIcons.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Single source for the execution-position highlight. Theme-variant so the colours
                 read well in both modes; reference these with DynamicResource so they switch live. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="HighlightBackgroundBrush" Color="#D6E4FF" />
                    <SolidColorBrush x:Key="HighlightForegroundBrush" Color="#1C1F23" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="HighlightBackgroundBrush" Color="#2080F0" />
                    <SolidColorBrush x:Key="HighlightForegroundBrush" Color="#FFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Memory/stream cell borders (same in both modes) -->
            <SolidColorBrush x:Key="CellBorderBrush" Color="#D3D3D3" />
            <SolidColorBrush x:Key="CellHighlightBorderBrush" Color="#F08080" />
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <semi:SemiTheme />
        <StyleInclude Source="avares://Semi.Avalonia.DataGrid/Index.axaml" />

        <!-- Jump labels in the Assembly view (e.g. "jne label0") -->
        <Style Selector="TextBlock.asmline.label">
        </Style>
        
        <!-- Source-label markers (e.g. "label0:") that other instructions jump to.
             These get their own marker-less DataTemplate, so they already start at the
             row origin (where the execution-marker image begins) — no negative margin needed. -->
        <Style Selector="TextBlock.asmline.sourcelabel">
            <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="FontStyle" Value="Italic" />
        </Style>
    </Application.Styles>

</Application>
