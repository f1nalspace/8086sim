<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Final.CPU8086</RootNamespace>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.17" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.17" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.17" />
    <!-- nur im Debug aktiv (DevTools via F12) -->
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.17" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CPU8086.Resources\CPU8086.Resources.csproj" />
    <ProjectReference Include="..\CPU8086\CPU8086.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Resources\**\*.png" />
  </ItemGroup>

  <!--
    Phase 2: Noch nicht portierte WPF/DevExpress-Quellen sind temporär aus dem Build genommen.
    Sie werden phasenweise wieder einkompiliert:
      Phase 3 - MVVM-Shim + ViewModels/Behaviors/Services/UI-freie Typen
      Phase 4 - Converters + BinaryGridView
    Als <None> referenziert, damit sie in Visual Studio / Rider sichtbar bleiben.
  -->
  <ItemGroup>
    <Compile Remove="AutoServiceBehavior.cs;DecodeState.cs;IAutoService.cs;LogItemViewModel.cs;MainViewModel.cs;StreamByte.cs" />
    <Compile Remove="Behaviors\**\*.cs;Controls\**\*.cs;Converters\**\*.cs;Services\**\*.cs" />
    <None Include="AutoServiceBehavior.cs;DecodeState.cs;IAutoService.cs;LogItemViewModel.cs;MainViewModel.cs;StreamByte.cs" />
    <None Include="Behaviors\**\*.cs;Controls\**\*.cs;Converters\**\*.cs;Services\**\*.cs" />
  </ItemGroup>

</Project>
